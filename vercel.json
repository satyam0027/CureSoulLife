{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "soullife.org" }],
      "destination": "https://www.curesoullife.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.soullife.org" }],
      "destination": "https://www.curesoullife.org/:path*",
      "permanent": true
    },
    {
      "source": "/webinar/",
      "destination": "/webinar",
      "permanent": true
    },
    {
      "source": "/webinar/welcome/",
      "destination": "/webinar/welcome",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/webinar", "destination": "/webinar/index.html" },
    { "source": "/webinar/welcome", "destination": "/webinar/welcome.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
